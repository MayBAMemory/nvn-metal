+    if (!img) img = row * hb;
+    unsigned level = v && v->set_levels ? (unsigned)v->base_level : 0, layer0 = v && v->set_layers ? (unsigned)v->min_layer : 0;
+    mtl_write_texels(o, level, layer0, r, src, (size_t)row, (size_t)img);
